#%%MARKDOWN
## Run: load → extract per descriptor → save (+ quick retrieval sanity)

#%%CODE
# === R.0 — load selected datasets ==========================================================
LOADERS = {"rc": load_robotcar, "cmu": load_cmu, "nord": load_nordland}
LOADED = {}
for key in DUMP:
    t0 = time.time()
    try: LOADED[key] = LOADERS[key](); log(f"R.0.{key}", "ok", f"{sum(len(p) for _, p in LOADED[key]['parts'])} images, {time.time()-t0:.0f}s")
    except Exception as e:
        import traceback; traceback.print_exc(); log(f"R.0.{key}", "fail", repr(e)[:200])
os.makedirs(os.path.join(CONFIG.OUT_DIR, "meta"), exist_ok=True)
def _save_meta(key, meta):
    if key == "cmu":
        for s, m in meta.items(): np.savez(os.path.join(CONFIG.OUT_DIR, "meta", f"cmu_{s}.npz"), **m)
    else: np.savez(os.path.join(CONFIG.OUT_DIR, "meta", f"{key}.npz"), **meta)
for key, D in LOADED.items(): _save_meta(key, D["meta"])
print("meta saved:", os.listdir(os.path.join(CONFIG.OUT_DIR, "meta")), flush=True)

#%%CODE
# === R.1 — extract + save =================================================================
FEATS = {}
for dname in DESCRIPTORS:
    try: fwd = build_extractor(dname)
    except Exception as e:
        import traceback; traceback.print_exc(); log(f"R.1.{dname}", "fail", repr(e)[:200]); continue
    od = os.path.join(CONFIG.OUT_DIR, dname); os.makedirs(od, exist_ok=True)
    for key, D in LOADED.items():
        for tag, paths in D["parts"]:
            arr = extract(paths, fwd, f"{dname}:{key}_{tag}")
            np.save(os.path.join(od, f"{key}_{tag}.npy"), arr); FEATS[(dname, key, tag)] = arr
    del fwd; torch.cuda.empty_cache()

#%%CODE
# === R.2 — retrieval sanity with official thresholds (top-1 reference pose) ===============
THR = [(0.25, 2.0), (0.5, 5.0), (5.0, 10.0)]
def recall_at(qC, qR, rC, rR, sim):
    top = sim.argmax(1); dt = np.linalg.norm(qC - rC[top], axis=1)
    da = np.array([rot_angle_deg(qR[i], rR[top[i]]) for i in range(len(top))])
    return [float(np.mean((dt <= t) & (da <= a))) for t, a in THR], dt
SANITY = {}
for dname in DESCRIPTORS:
    if "rc" in LOADED and (dname, "rc", "ref") in FEATS:
        m = LOADED["rc"]["meta"]; S = FEATS[(dname, "rc", "q")].astype(np.float32) @ FEATS[(dname, "rc", "ref")].astype(np.float32).T
        for c in sorted(set(m["q_cond"])):
            i = m["q_cond"] == c; r, dt = recall_at(m["q_C"][i], m["q_R"][i], m["ref_C"], m["ref_R"], S[i])
            SANITY[f"{dname}/rc/{c}"] = r; print(f"  {dname} RobotCar {c:16s} n={i.sum():4d} R@1 (.25m,2)/(.5m,5)/(5m,10) = {r[0]:.3f}/{r[1]:.3f}/{r[2]:.3f} | median err {np.median(dt):.1f} m", flush=True)
    if "cmu" in LOADED:
        for s, m in LOADED["cmu"]["meta"].items():
            if (dname, "cmu", f"{s}_db") not in FEATS: continue
            S = FEATS[(dname, "cmu", f"{s}_q")].astype(np.float32) @ FEATS[(dname, "cmu", f"{s}_db")].astype(np.float32).T
            r, dt = recall_at(m["q_C"], m["q_R"], m["db_C"], m["db_R"], S); SANITY[f"{dname}/cmu/{s}"] = r
            print(f"  {dname} CMU {s:5s} n={len(dt):5d} R@1 = {r[0]:.3f}/{r[1]:.3f}/{r[2]:.3f} | median err {np.median(dt):.1f} m", flush=True)
    if "nord" in LOADED and (dname, "nord", "summer") in FEATS:
        ref = FEATS[(dname, "nord", "summer")].astype(np.float32)
        for s in ["spring", "fall", "winter"]:
            if (dname, "nord", s) not in FEATS: continue
            top = (FEATS[(dname, "nord", s)].astype(np.float32) @ ref.T).argmax(1); err = np.abs(top - np.arange(len(top)))
            SANITY[f"{dname}/nord/{s}"] = [float(np.mean(err <= k)) for k in (0, 1, 2)]
            print(f"  {dname} Nordland {s:7s} R@1 (0/1/2 frames) = " + "/".join(f"{np.mean(err<=k):.3f}" for k in (0, 1, 2)), flush=True)

#%%CODE
# === R.3 — summary =========================================================================
summary = {"report": REPORT, "throughput": THROUGHPUT, "sanity": SANITY, "dump": DUMP, "descriptors": DESCRIPTORS,
           "files": sorted(os.path.relpath(os.path.join(d, f), CONFIG.OUT_DIR) for d, _, fs in os.walk(CONFIG.OUT_DIR) for f in fs)}
json.dump(summary, open(os.path.join(CONFIG.OUT_DIR, "summary.json"), "w"), indent=1, default=str)
tot = sum(os.path.getsize(os.path.join(d, f)) for d, _, fs in os.walk(CONFIG.OUT_DIR) for f in fs)
print(f"DUMP_DONE files={len(summary['files'])} size={tot/1e6:.0f} MB", flush=True)
print("NB15_JSON=" + json.dumps({"sanity": SANITY, "fails": [k for k, v in REPORT.items() if v['status'] == 'fail']}), flush=True)
