#%%MARKDOWN
## Dataset loaders (paths + poses). Every loader returns `{"parts": [(tag, paths)], "meta": {...}}`.

#%%CODE
# === L.RC — RobotCar-Seasons v2: overcast-reference rear map (NVM) + train queries =========
def _walk_find(root, name, max_depth=4):
    for d, subs, files in os.walk(root):
        if d.count(os.sep) - root.count(os.sep) >= max_depth: subs[:] = []
        if name in files: return os.path.join(d, name)
    return None

def load_robotcar():
    RC = PATHS["robotcar"]; assert RC, "robotcar mount not found"
    tr_txt = _walk_find(RC, "robotcar_v2_train.txt") or _walk_find("/kaggle/input", "robotcar_v2_train.txt", 6)
    nvm = os.path.join(RC, "3D-models", "all-merged", "all.nvm")
    if not os.path.isfile(nvm): nvm = _walk_find(RC, "all.nvm", 5)
    print("train.txt:", tr_txt, "| nvm:", nvm, flush=True)
    idx = {}
    for d, _, files in os.walk(os.path.join(RC, "images")):
        cam = os.path.basename(d)
        for f in files:
            if f.lower().endswith((".jpg", ".png")): idx[(cam, os.path.splitext(f)[0])] = os.path.join(d, f)
    print("image index:", len(idx), flush=True)
    # reference poses from the NVM camera block (quaternion = world->camera rotation, then camera centre)
    ref = []
    with open(nvm) as fh:
        fh.readline(); line = fh.readline()
        while line.strip() == "": line = fh.readline()
        n = int(line.split()[0])
        for _ in range(n):
            t = fh.readline().split(); parts = t[0].replace("\\", "/").split("/")
            cond, cam, ts = parts[-3], parts[-2], os.path.splitext(parts[-1])[0]
            if cond != "overcast-reference" or cam != "rear": continue
            q = np.array(list(map(float, t[2:6]))); C = np.array(list(map(float, t[6:9])))
            p = idx.get((cam, ts))
            if p: ref.append((t[0], p, C, quat_to_R(q).T, float(t[1])))
    print("NVM cameras:", n, "| overcast-reference/rear resolved:", len(ref), flush=True)
    qry = []
    for ln in open(tr_txt):
        t = ln.split()
        if len(t) < 17: continue
        M = np.array(list(map(float, t[1:17]))).reshape(4, 4)        # camera -> world (verified)
        cond, cam, ts = t[0].split("/")[0], t[0].split("/")[-2], os.path.splitext(t[0].split("/")[-1])[0]
        p = idx.get((cam, ts))
        if p: qry.append((t[0], p, M[:3, 3].copy(), M[:3, :3].copy(), cond))
    print("train queries resolved:", len(qry), "/ 1906", flush=True)
    meta = {"ref_names": np.array([r[0] for r in ref]), "ref_C": np.stack([r[2] for r in ref]),
            "ref_R": np.stack([r[3] for r in ref]), "ref_focal": np.array([r[4] for r in ref]),
            "q_names": np.array([q[0] for q in qry]), "q_C": np.stack([q[2] for q in qry]),
            "q_R": np.stack([q[3] for q in qry]), "q_cond": np.array([q[4] for q in qry])}
    # sanity: same world frame?  nearest reference centre per query + its orientation gap
    D = np.sqrt(((meta["q_C"][:, None, :] - meta["ref_C"][None, :, :]) ** 2).sum(-1)); nn = D.argmin(1)
    ang = np.array([rot_angle_deg(meta["q_R"][i], meta["ref_R"][nn[i]]) for i in range(len(nn))])
    log("L.RC.sanity", "ok" if np.median(D.min(1)) < 5 else "warn",
        f"query->nearest-ref dist median {np.median(D.min(1)):.2f} m (p90 {np.percentile(D.min(1),90):.2f}); "
        f"orientation gap median {np.median(ang):.1f} deg (p90 {np.percentile(ang,90):.1f})")
    return {"parts": [("ref", [r[1] for r in ref]), ("q", [q[1] for q in qry])], "meta": meta}

#%%CODE
# === L.CMU — Extended-CMU-Seasons: official database + dated query GT, camera c0 ===========
def _cmu_bases():
    out = {}
    for r in glob.glob("/kaggle/input/*"):
        for pat in ["slice*", "*/slice*", "*/*/slice*"]:
            for d in glob.glob(os.path.join(r, pat)):
                nm = os.path.basename(d)
                if not (os.path.isdir(d) and nm.startswith("slice") and nm[5:].isdigit()): continue
                inner = os.path.join(d, nm); b = inner if os.path.isdir(inner) else d
                if os.path.isdir(os.path.join(b, "camera-poses")): out.setdefault(int(nm[5:]), b)
    return out

def _read_poses(txt, cam="_c0_"):
    rows = []
    for ln in open(txt):
        t = ln.split()
        if len(t) < 8 or cam not in t[0]: continue
        try: v = [float(x) for x in t[1:8]]
        except ValueError: continue
        rows.append((t[0], np.array(v[4:7]), quat_to_R(v[:4]).T))     # centre, R camera->world
    return rows

def load_cmu():
    bases = _cmu_bases(); print("CMU slices with camera-poses:", sorted(bases), flush=True)
    parts, meta, total = [], {}, 0
    for s in CONFIG.CMU_SLICE_ORDER:
        if s not in bases: continue
        b = bases[s]; dbt = os.path.join(b, f"ground-truth-database-images-slice{s}.txt")
        if not os.path.isfile(dbt): continue
        idx = {}
        for sub in ["database", "query"]:
            for d, _, files in os.walk(os.path.join(b, sub)):
                for f in files: idx[f] = os.path.join(d, f)
        db = [(n, idx[n], C, R) for n, C, R in _read_poses(dbt) if n in idx]
        qs = []
        for pf in sorted(glob.glob(os.path.join(b, "camera-poses", "*.txt"))):
            date = "".join(ch for ch in os.path.basename(pf) if ch.isdigit())[-8:]
            qs += [(n, idx[n], C, R, date) for n, C, R in _read_poses(pf) if n in idx]
        if len(db) < 50 or len(qs) < 100: continue
        if total + len(db) + len(qs) > CONFIG.CMU_MAX_IMAGES: break
        total += len(db) + len(qs)
        parts += [(f"s{s}_db", [x[1] for x in db]), (f"s{s}_q", [x[1] for x in qs])]
        meta[f"s{s}"] = {"db_names": np.array([x[0] for x in db]), "db_C": np.stack([x[2] for x in db]),
                         "db_R": np.stack([x[3] for x in db]), "q_names": np.array([x[0] for x in qs]),
                         "q_C": np.stack([x[2] for x in qs]), "q_R": np.stack([x[3] for x in qs]),
                         "q_cond": np.array([x[4] for x in qs])}
        dmin = np.sqrt(((meta[f"s{s}"]["q_C"][:, None] - meta[f"s{s}"]["db_C"][None]) ** 2).sum(-1)).min(1)
        print(f"  slice{s}: db={len(db)} q={len(qs)} dates={len(set(x[4] for x in qs))} "
              f"| q->nearest-db median {np.median(dmin):.2f} m", flush=True)
    log("L.CMU", "ok" if meta else "fail", f"{len(meta)} slices, {total} images")
    return {"parts": parts, "meta": meta}

#%%CODE
# === L.NORD — Nordland 4 seasons, frame-aligned, uniform subsample ========================
def load_nordland():
    root = PATHS["nordland"]; assert root, "nordland mount not found"
    def season_dir(s):
        c = [d for d, _, fs in os.walk(root) if os.path.basename(d).lower() == s and any(f.lower().endswith((".png", ".jpg")) for f in fs)]
        return sorted(c, key=lambda p: -p.count(os.sep))[0] if c else None
    def fid(f):
        d = "".join(ch for ch in os.path.splitext(f)[0] if ch.isdigit()); return int(d) if d else None
    tracks = {}
    for s in ["summer", "spring", "fall", "winter"]:
        d = season_dir(s)
        if d: tracks[s] = {fid(f): os.path.join(d, f) for f in os.listdir(d) if f.lower().endswith((".png", ".jpg")) and fid(f) is not None}
    common = sorted(set.intersection(*[set(v) for v in tracks.values()]))
    sel = np.unique(np.linspace(0, len(common) - 1, CONFIG.NORD_PER_SEASON).round().astype(int))
    fids = [common[i] for i in sel]
    log("L.NORD", "ok", f"seasons={list(tracks)} common={len(common)} selected={len(fids)} (stride~{len(common)/len(fids):.1f})")
    return {"parts": [(s, [tracks[s][f] for f in fids]) for s in tracks], "meta": {"frame_ids": np.array(fids), "seasons": np.array(list(tracks))}}
