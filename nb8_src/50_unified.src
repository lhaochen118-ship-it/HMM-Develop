#%%MARKDOWN
## NB8 — Unified geometry calibration: calibrate the BELIEF, single-image OR filter posterior (RobotCar)

NB6/NB7 gave a nuanced result: CRSG (calibrate the single-image retrieval geometry) dominates on sparse RobotCar,
but the sequential filter is better on dense Nordland. Unifying hypothesis: **geometry calibration is a wrapper
that applies to whatever belief you have.** Apply it to the *filter's posterior* geometry (max prob, top1−top2
margin, entropy, null mass) → "CRSG-filter". If CRSG-filter recovers CRSG-single's reliability on sparse RobotCar
(i.e. calibration rescues the filter that raw-filtering broke), then one calibrated-belief method is regime-robust.

Methods compared (pooled cross-fit, pose tolerance swept): softmax, raw fixed-filter, **CRSG-single** (ours, NB6),
**CRSG-filter** (ours, new: calibrate filter-posterior geometry).

#%%CODE
# === U.0 — map / episode / helpers (as NB6) =========================================
def pose_dist_mat(A, Bx): return np.sqrt(((A[:, None, :] - Bx[None, :, :]) ** 2).sum(-1))
def build_route_order(xyz):
    n = len(xyz)
    if n <= 2: return np.arange(n)
    start = int(np.argmax(((xyz - xyz.mean(0)) ** 2).sum(1))); D = pose_dist_mat(xyz, xyz); np.fill_diagonal(D, 1e18)
    order = [start]; used = np.zeros(n, bool); used[start] = True
    for _ in range(n - 1):
        d = D[order[-1]].copy(); d[used] = 1e18; nxt = int(np.argmin(d)); order.append(nxt); used[nxt] = True
    return np.array(order)
def make_map(B):
    o = build_route_order(COND[B]["xyz"]); return dict(desc=DESC[B][o], xyz=COND[B]["xyz"][o], M=len(o))
def rc_episode(Q, MAP):
    D = pose_dist_mat(COND[Q]["xyz"], MAP["xyz"]); gt = D.argmin(1); gtd = D[np.arange(len(D)), gt]; s = np.argsort(gt, kind="stable")
    return dict(sim=cosine_sim(DESC[Q][s], MAP["desc"]), qd=DESC[Q][s], q_xyz=COND[Q]["xyz"][s], gt=gt[s], gtd=gtd[s])

def geom_features(sim, k=5):
    part = np.sort(sim, 1)[:, ::-1][:, :max(k, 2)]; maxs = part[:, 0]
    gap12 = part[:, 0] - part[:, 1]; p = np.exp(sim / 0.05 - _logsumexp(sim / 0.05, 1)[:, None]); ent = -(p * np.log(p + 1e-12)).sum(1)
    sue = np.sqrt(np.maximum(2 - 2 * maxs, 0.0)); return np.stack([gap12, maxs, sue, ent], 1), ["gap12", "maxsim", "sue", "entropy"]

def belief_geom(place_post, null_post):
    """geometry features of a filter posterior over places (+ null mass)."""
    srt = np.sort(place_post, 1)[:, ::-1]; maxp = srt[:, 0]; gap = srt[:, 0] - srt[:, 1]
    ent = -(place_post * np.log(place_post + 1e-12)).sum(1)
    return np.stack([gap, maxp, null_post, ent], 1), ["gap", "maxp", "null", "entropy"]

def filter_beliefs(sim, tau, null_quantile=0.98, exit_prob=0.01):
    """run the fixed-observation filter and return per-step posterior (place dist, null)."""
    T, M = sim.shape; offs, w = make_motion_kernel(CONFIG.MOTION_VELOCITY, CONFIG.MOTION_STD)
    place = np.full(M, (1 - CONFIG.NULL_PRIOR) / M); null = CONFIG.NULL_PRIOR
    P = np.empty((T, M)); Nl = np.empty(T); pred = np.empty(T, np.int64)
    for t in range(T):
        pp = (1 - exit_prob) * predict_place(place, offs, w, CONFIG.MOTION_LEAK) + null * (1 - CONFIG.NULL_SELF) / M
        pn = CONFIG.NULL_SELF * null + exit_prob * place.sum()
        logb = np.empty(M + 1); logb[:M] = np.log(pp + 1e-30) + sim[t] / tau
        logb[M] = np.log(pn + 1e-30) + np.quantile(sim[t], null_quantile) / tau
        logb -= _logsumexp(logb); b = np.exp(logb); place, null = b[:M], b[M]; sden = place.sum() + null; place, null = place / sden, null / sden
        P[t] = place; Nl[t] = null; pred[t] = int(np.argmax(place))
    return pred, P, Nl

def fit_logistic(X, y, iters=800, lr=0.3, l2=1e-4):
    mu = X.mean(0); sd = X.std(0) + 1e-9; Z = (X - mu) / sd; w = np.zeros(X.shape[1]); b = 0.0; n = len(Z)
    for _ in range(iters):
        p = 1 / (1 + np.exp(-(Z @ w + b))); w -= lr * (Z.T @ (p - y) / n + l2 * w); b -= lr * (p - y).mean()
    return lambda Xx: 1 / (1 + np.exp(-(((Xx - mu) / sd) @ w + b)))
def risk_coverage(conf, correct):
    o = np.argsort(-conf); err = 1.0 - correct[o]; return float((np.cumsum(err) / np.arange(1, len(err) + 1)).mean())
def pose_correct(pred, q_xyz, map_xyz, tol): return (np.sqrt(((q_xyz - map_xyz[pred]) ** 2).sum(1)) <= tol).astype(float)

avail = list(DESC.keys()); REF = next((p for p in ["overcast-summer", "sun"] if p in avail), avail[0]); MAP = make_map(REF)
ALLC = [c for c in avail if c != REF]
print("ref =", REF, "| conds =", ALLC)
RES8 = OrderedDict(); log("U.0", "ok", f"ref={REF}")

#%%CODE
# === U.1 — build per-frame belief tables (single-image geom + filter-posterior geom) ==
# fit a global tau first (on a 50% frame split defined here)
rows = {"sim_feat": [], "fil_feat": [], "pred_err_single": [], "pred_err_filter": [], "cond": [], "sim": [], "gt": []}
# need tau before filtering: quick fit on all episodes' matched frames
S, G = [], []
for q in ALLC:
    ep = rc_episode(q, MAP); k = ep["gtd"] <= 5.0; S.append(ep["sim"][k]); G.append(ep["gt"][k])
TAU_G = fit_temperature(np.concatenate(S), np.concatenate(G))[0]
for ci, q in enumerate(ALLC):
    ep = rc_episode(q, MAP); sf, _ = geom_features(ep["sim"])
    pred_s = ep["sim"].argmax(1); pe_s = np.sqrt(((ep["q_xyz"] - MAP["xyz"][pred_s]) ** 2).sum(1))
    predf, P, Nl = filter_beliefs(ep["sim"], TAU_G); bf, _ = belief_geom(P, Nl)
    pe_f = np.sqrt(((ep["q_xyz"] - MAP["xyz"][predf]) ** 2).sum(1))
    rows["sim_feat"].append(sf); rows["fil_feat"].append(bf); rows["pred_err_single"].append(pe_s)
    rows["pred_err_filter"].append(pe_f); rows["cond"].append(np.full(len(pe_s), ci)); rows["sim"].append(ep["sim"]); rows["gt"].append(ep["gt"])
T = {k: np.concatenate(v) for k, v in rows.items()}
print(f"tau_g={TAU_G:.4f} | N={len(T['pred_err_single'])}")
print("R@tol single vs filter:", {t: (round(float((T['pred_err_single'] <= t).mean()), 3), round(float((T['pred_err_filter'] <= t).mean()), 3)) for t in [0.5, 1, 2, 5]})
log("U.1", "ok", f"N={len(T['pred_err_single'])}")

#%%CODE
# === U.2 — compare softmax / raw-filter / CRSG-single / CRSG-filter, swept over tol ==
rng = np.random.default_rng(CONFIG.SEED); fitm = rng.random(len(T["pred_err_single"])) < 0.5
def softmax_conf(sim, tau):
    lp = sim / tau; pr = np.exp(lp - _logsumexp(lp, 1)[:, None]); return pr.max(1)
def ev(conf, y): return dict(ECE=float(ece_from_conf(conf, y, CONFIG.ECE_BINS)[0]), AURC=float(risk_coverage(conf, y)), conf_auroc=float(auroc(conf, y)))

TOLS = [0.5, 1.0, 2.0, 5.0]
for tol in TOLS:
    ys = (T["pred_err_single"] <= tol).astype(float); yf = (T["pred_err_filter"] <= tol).astype(float)
    conf_soft = softmax_conf(T["sim"][~fitm], TAU_G)
    crsg_s = fit_logistic(T["sim_feat"][fitm], ys[fitm])(T["sim_feat"][~fitm])
    crsg_f = fit_logistic(T["fil_feat"][fitm], yf[fitm])(T["fil_feat"][~fitm])
    raw_fil = T["fil_feat"][~fitm][:, 1]   # maxp = raw filter confidence
    res = {"softmax": ev(conf_soft, ys[~fitm]), "raw_filter": ev(raw_fil, yf[~fitm]),
           "CRSG-single": ev(crsg_s, ys[~fitm]), "CRSG-filter": ev(crsg_f, yf[~fitm])}
    RES8[tol] = {"acc_single": float(ys[~fitm].mean()), "acc_filter": float(yf[~fitm].mean()), "res": res}
    print(f"\n[tol={tol}m  acc single={ys[~fitm].mean():.3f}/filter={yf[~fitm].mean():.3f}]  {'method':<14}{'ECE':>8}{'AURC':>8}{'conf-AUROC':>11}")
    for m in res: print(f"{'':>30}{m:<14}{res[m]['ECE']:>8.4f}{res[m]['AURC']:>8.4f}{res[m]['conf_auroc']:>11.4f}")
log("U.2", "ok", "unified comparison done")

#%%CODE
# === U.3 — verdict ===================================================================
th = min(TOLS, key=lambda t: abs(RES8[t]["acc_single"] - 0.80))
R = RES8[th]["res"]
cs, cf = R["CRSG-single"], R["CRSG-filter"]
# on sparse RobotCar we expect CRSG-single best; CRSG-filter should at least recover (not collapse like raw filter)
crsg_filter_recovers = cf["conf_auroc"] >= R["raw_filter"]["conf_auroc"] and cf["AURC"] <= R["raw_filter"]["AURC"] + 1e-9
best = min(R, key=lambda m: R[m]["AURC"])
summary = dict(dataset="robotcar", ref=REF, headline_tol=th,
               headline={m: {"ECE": round(R[m]["ECE"], 4), "AURC": round(R[m]["AURC"], 4), "conf_auroc": round(R[m]["conf_auroc"], 4)} for m in R},
               best_by_aurc=best, crsg_filter_recovers_vs_rawfilter=bool(crsg_filter_recovers),
               sweep={str(t): {m: round(RES8[t]["res"][m]["AURC"], 4) for m in RES8[t]["res"]} for t in TOLS})
print(f"\n================ NB8 UNIFIED VERDICT (RobotCar, tol={th}m) ================")
for m in R: print(f"  {m:<14} ECE={R[m]['ECE']:.4f} AURC={R[m]['AURC']:.4f} conf-AUROC={R[m]['conf_auroc']:.4f}")
print(f"best by AURC = {best} | CRSG-filter recovers vs raw filter = {crsg_filter_recovers}")
print("NB8_JSON=" + json.dumps(summary)); log("U.3", "ok", f"best={best}")
