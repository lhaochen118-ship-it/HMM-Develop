#%%MARKDOWN
# DIVE-HMM diagnostic — SALAD API + GPU + timing
Dumps the bundle's SALAD/DINOv2 source + checkpoint keys so the loader can be finalized, reports the GPU
assigned to API kernels, and microbenchmarks DINOv2 extraction throughput.

#%%CODE
import os, sys, glob, time, json, subprocess, traceback
print("=== GPU ===")
try:
    print(subprocess.run(["nvidia-smi","--query-gpu=name,memory.total,driver_version","--format=csv,noheader"],
                         capture_output=True, text=True).stdout.strip())
except Exception as e:
    print("nvidia-smi failed:", e)
import torch
print("torch", torch.__version__, "| cuda avail:", torch.cuda.is_available())
if torch.cuda.is_available():
    p = torch.cuda.get_device_properties(0)
    print("GPU:", p.name, "| VRAM", round(p.total_memory/1e9,1), "GB | bf16", torch.cuda.is_bf16_supported())

#%%CODE
# locate bundle + print salad/dinov2 trees
cands = glob.glob("/kaggle/input/**/bundle", recursive=True)
BUN = next((c for c in cands if os.path.isdir(os.path.join(c,"checkpoints"))), (cands[0] if cands else None))
print("BUNDLE =", BUN)
if BUN:
    print("checkpoints:", sorted(os.listdir(os.path.join(BUN,"checkpoints"))))
    for sub in ["sources/salad","sources/dinov2"]:
        base = os.path.join(BUN, sub)
        if os.path.isdir(base):
            print("\n==== TREE", sub, "====")
            for d,_,fs in os.walk(base):
                depth = d[len(base):].count(os.sep)
                if depth > 3: continue
                print("  "*depth + os.path.basename(d) + "/")
                for f in sorted(fs)[:40]:
                    if f.endswith((".py",".md",".txt",".yaml",".yml",".json")): print("  "*depth + "   " + f)

#%%CODE
# dump the key SALAD source files (so the exact loader can be written)
def dump(path, n=6000):
    if os.path.isfile(path):
        print("\n" + "="*22 + " " + path + " " + "="*22)
        print(open(path, encoding="utf-8", errors="ignore").read()[:n])
    else:
        print("MISSING", path)
if BUN:
    sroot = os.path.join(BUN, "sources", "salad")
    print("ALL .py in sources/salad:")
    for p in sorted(glob.glob(os.path.join(sroot,"**","*.py"), recursive=True)):
        print("   ", os.path.relpath(p, sroot))
    for f in ["vpr_model.py","main.py","models/__init__.py","models/aggregators/salad.py",
              "models/backbones/dinov2.py","models/helper.py","__init__.py"]:
        dump(os.path.join(sroot, f))

#%%CODE
# wire bundle sources, try importing VPRModel, dump its signature + checkpoint keys
if BUN:
    for sub in ["sources/salad","sources/dinov2","sources/Hierarchical-Localization","sources/LightGlue"]:
        p = os.path.join(BUN, sub)
        if os.path.isdir(p) and p not in sys.path: sys.path.insert(0, p)
    try:
        import inspect
        from vpr_model import VPRModel
        print("VPRModel import OK")
        print("signature:", inspect.signature(VPRModel.__init__))
    except Exception:
        print("VPRModel import failed:"); traceback.print_exc()
    try:
        ck = os.path.join(BUN, "checkpoints", "dino_salad.ckpt")
        sd = torch.load(ck, map_location="cpu"); sd = sd.get("state_dict", sd)
        ks = list(sd.keys())
        print("\ndino_salad.ckpt: #keys =", len(ks))
        print("first 25:", ks[:25])
        print("last 10:", ks[-10:])
        # infer dims from a few tensors
        for k in ks[:5] + ks[-3:]:
            try: print("  ", k, tuple(sd[k].shape))
            except Exception: pass
    except Exception:
        traceback.print_exc()

#%%CODE
# timing microbench: DINOv2 extraction throughput (GPU-only, excl. disk decode)
try:
    imgs = sorted(glob.glob("/kaggle/input/**/summer/*.png", recursive=True))[:128]
    print("sample images:", len(imgs))
    vit_base = __import__("dinov2.models.vision_transformer", fromlist=["vit_base"]).vit_base
    vit = vit_base(patch_size=14, img_size=518, init_values=1.0, block_chunks=0)
    pth = os.path.join(BUN, "checkpoints", "dinov2_vitb14_pretrain.pth")
    sd = torch.load(pth, map_location="cpu"); sd = sd.get("state_dict", sd)
    vit.load_state_dict(sd, strict=False); vit.eval().cuda()
    from PIL import Image
    import torchvision.transforms as T
    tx = T.Compose([T.Resize((322,322)), T.ToTensor(), T.Normalize((0.485,0.456,0.406),(0.229,0.224,0.225))])
    t_dec = time.time()
    batch = torch.stack([tx(Image.open(p).convert("RGB")) for p in imgs])
    dec_s = time.time() - t_dec
    batch = batch.cuda()
    torch.cuda.synchronize(); t0 = time.time()
    with torch.no_grad(), torch.autocast("cuda", dtype=torch.bfloat16):
        for _ in range(3):
            f = vit.forward_features(batch)
    torch.cuda.synchronize(); gpu_s = (time.time()-t0)/3
    print(f"decode+transform {len(imgs)} imgs: {dec_s:.2f}s ({len(imgs)/dec_s:.1f} img/s)")
    print(f"DINOv2 GPU fwd: {len(imgs)} imgs in {gpu_s:.3f}s -> {len(imgs)/gpu_s:.1f} img/s")
    print(f"=> est. end-to-end ~{len(imgs)/(dec_s/1 + gpu_s):.0f} img/s single-thread (NUM_WORKERS>0 speeds decode)")
except Exception:
    traceback.print_exc()
print("\nDIAG DONE")
